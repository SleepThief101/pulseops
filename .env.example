# Runtime Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
ENABLE_DOCS=true
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
POSTGRES_USER=pulseops
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_DB=pulseops

# Ports
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Application connections
DATABASE_URL=postgresql+psycopg://pulseops:change_this_local_password@db:5432/pulseops
REDIS_URL=redis://redis:6379/0

# Dedicated Test Database connection (Required for test suite; never falls back to DATABASE_URL)
TEST_DATABASE_URL=postgresql+psycopg://pulseops:change_this_local_password@db:5432/pulseops_test

# Security and Encryption
# Generate a local Fernet key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=replace_with_base64_fernet_key

# JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_secure_random_secret_at_least_32_chars

# Optional External Integration & AI Keys (fallback/mock modes apply when unset)
RAZORPAY_MOCK_FALLBACK=true
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5173/integrations/github/callback
DEEPSEEK_API_KEY=
DEEPSEEK_MAX_TOKENS=800
DEEPSEEK_MAX_TOOL_ROUNDS=3
COPILOT_CACHE_TTL_SECONDS=120
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX_REQUESTS=20
RATE_LIMIT_COPILOT_MAX_REQUESTS=20
RATE_LIMIT_ORG_WRITE_MAX_REQUESTS=60
WEBHOOK_REPLAY_TOLERANCE_SECONDS=300
WEBHOOK_FUTURE_SKEW_SECONDS=60
DEMO_ACCOUNT_EMAIL=demo@pulseops.example.com
DEMO_COPILOT_DAILY_LIMIT=5
